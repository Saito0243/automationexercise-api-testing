        {
          "name": "POST To Search Products",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Search request was successful\", function () {\r",
                  "    pm.response.to.have.status(200);\r",
                  "});\r",
                  "\r",
                  "pm.test(\"Search returns products\", function () {\r",
                  "    const jsonData = pm.response.json();\r",
                  "\r",
                  "    pm.expect(jsonData.products).to.be.an(\"array\");\r",
                  "    pm.expect(jsonData.products.length).to.be.greaterThan(0);\r",
                  "});\r",
                  "\r",
                  "pm.test(\"All search results contain the search term\", function () {\r",
                  "    const jsonData = pm.response.json();\r",
                  "    const searchTerm = \"jean\";\r",
                  "\r",
                  "    jsonData.products.forEach(function (product) {\r",
                  "        pm.expect(product.name.toLowerCase()).to.include(searchTerm);\r",
                  "    });\r",
                  "});"
